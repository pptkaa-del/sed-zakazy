# Скопируйте этот файл в sed.env рядом с server.js и поправьте значения.
# Переменные окружения, заданные панелью или системой, важнее этого файла.

# Где хранить данные. По умолчанию: ~/sed-zakazy-data (вне папки сайта).
# DATA_DIR=/var/www/USER/data/sed-zakazy-data

# Порт или путь к Unix-сокету. Обычно задаёт панель хостинга сама.
# PORT=3000

# Включите после того, как сайт заработает по HTTPS.
# COOKIE_SECURE=1

# Предельный размер загружаемого файла, МБ.
# MAX_FILE_MB=50

# Срок жизни входа, дней.
# SESSION_DAYS=14

# Подложка карты (вкладка «Карта»). По умолчанию — OpenStreetMap:
# MAP_TILES=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Если OpenStreetMap не показывает карту («Access blocked»), можно взять другой источник, например CARTO
# (бесплатно при умеренной нагрузке, условия: https://carto.com/basemaps):
# MAP_TILES=https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}.png
# MAP_ATTRIBUTION=&copy; OpenStreetMap &copy; CARTO
# MAP_SUBDOMAINS=abcd
# MAP_MAX_ZOOM=19
# BACKUP_MAX_MB=2048
