# Скопируйте этот файл в sed.env рядом с server.js и поправьте значения.
# Переменные окружения, заданные панелью или системой, важнее этого файла.

# Где хранить данные. По умолчанию: ~/sed-zakazy-data (вне папки сайта).
# DATA_DIR=/var/www/USER/data/sed-zakazy-data

# Порт или путь к Unix-сокету. Обычно задаёт панель хостинга сама.
# PORT=3000

# Включите после того, как сайт заработает по HTTPS.
# COOKIE_SECURE=1

# Предельный размер загружаемого файла, МБ.
# MAX_FILE_MB=50

# Срок жизни входа, дней.
# SESSION_DAYS=14
